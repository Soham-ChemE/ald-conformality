/*--------------------------------*- C++ -*----------------------------------*\
| Axisymmetric single-wafer showerhead chamber, 5 degree wedge.              |
| r: 0..200 mm (wafer 0..150, floor 150..200), z: 0..15 mm gap.               |
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }

scale 0.001;   // mm -> m

Rw 150;        // wafer radius
Rc 200;        // chamber radius (outlet)
G  17.5;         // showerhead-to-wafer gap
theta 2.5;     // half wedge angle, deg

// y = r cos(theta), z_wedge = +- r sin(theta); OpenFOAM axis is x here (z of the chamber)
// Use x = axial (0..G), y = radial, z = out of plane.
cy #calc "cos(degToRad($theta))";
sz #calc "sin(degToRad($theta))";

vertices
(
    (0   0 0)                                   // 0 axis bottom
    ($G  0 0)                                   // 1 axis top
    (0   #calc "$Rw*$cy" #calc "-$Rw*$sz")      // 2
    ($G  #calc "$Rw*$cy" #calc "-$Rw*$sz")      // 3
    (0   #calc "$Rw*$cy" #calc " $Rw*$sz")      // 4
    ($G  #calc "$Rw*$cy" #calc " $Rw*$sz")      // 5
    (0   #calc "$Rc*$cy" #calc "-$Rc*$sz")      // 6
    ($G  #calc "$Rc*$cy" #calc "-$Rc*$sz")      // 7
    (0   #calc "$Rc*$cy" #calc " $Rc*$sz")      // 8
    ($G  #calc "$Rc*$cy" #calc " $Rc*$sz")      // 9
);

blocks
(
    // block 0: wafer region r 0..Rw  (axial 30 cells, radial 150 cells, 1 cell wedge)
    hex (0 1 3 2 0 1 5 4) (35 150 1) simpleGrading (1 1 1)
    // block 1: floor region r Rw..Rc
    hex (2 3 7 6 4 5 9 8) (35 50 1) simpleGrading (1 1 1)
);

edges ();

boundary
(
    showerhead { type patch; faces ((1 3 5 1)); }           // top of block 0 (x = G, r < Rw): inflow
    topWall    { type wall;  faces ((3 7 9 5)); }           // top of block 1
    wafer      { type wall;  faces ((0 2 4 0)); }           // bottom of block 0
    floor      { type wall;  faces ((2 6 8 4)); }           // bottom of block 1
    outlet     { type patch; faces ((6 7 9 8)); }           // r = Rc
    axis       { type empty; faces ((0 1 1 0)); }           // degenerate, r = 0
    front      { type wedge; faces ((0 1 3 2) (2 3 7 6)); }
    back       { type wedge; faces ((0 4 5 1) (4 8 9 5)); }
);

mergePatchPairs ();
