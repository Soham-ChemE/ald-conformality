/*  Showerhead chamber with an edge ring and pumping below the wafer plane (5 degree wedge).
    Region A: wafer, r 0..150 mm, gap 15 mm (showerhead inflow above).
    Region B: edge ring, r 150..175 mm, same gap; the ring top is a wall at the wafer plane (non-absorbing).
    Region C: pumping annulus, r 175..200 mm, from 25 mm BELOW the wafer plane to the gap height; outlet at its floor.
    x = axial (0 at the wafer plane, positive toward the showerhead), y = radial, z = out of plane.               */
FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }
scale 0.001;
Rw 150; Rr 175; Rc 200; G 15; Hp 25; theta 2.5;
cy #calc "cos(degToRad($theta))"; sz #calc "sin(degToRad($theta))";
vertices
(
    (0 0 0) (#calc "$G" 0 0)                                                  // 0 1 axis
    (0 #calc "$Rw*$cy" #calc "-$Rw*$sz") (#calc "$G" #calc "$Rw*$cy" #calc "-$Rw*$sz")        // 2 3 (back, r=Rw)
    (0 #calc "$Rw*$cy" #calc "$Rw*$sz")  (#calc "$G" #calc "$Rw*$cy" #calc "$Rw*$sz")         // 4 5 (front, r=Rw)
    (0 #calc "$Rr*$cy" #calc "-$Rr*$sz") (#calc "$G" #calc "$Rr*$cy" #calc "-$Rr*$sz")        // 6 7 (back, r=Rr)
    (0 #calc "$Rr*$cy" #calc "$Rr*$sz")  (#calc "$G" #calc "$Rr*$cy" #calc "$Rr*$sz")         // 8 9 (front, r=Rr)
    (#calc "-$Hp" #calc "$Rr*$cy" #calc "-$Rr*$sz") (#calc "-$Hp" #calc "$Rr*$cy" #calc "$Rr*$sz")   // 10 11 (r=Rr, bottom of pump slot)
    (#calc "-$Hp" #calc "$Rc*$cy" #calc "-$Rc*$sz") (#calc "$G" #calc "$Rc*$cy" #calc "-$Rc*$sz")    // 12 13 (back, r=Rc)
    (#calc "-$Hp" #calc "$Rc*$cy" #calc "$Rc*$sz")  (#calc "$G" #calc "$Rc*$cy" #calc "$Rc*$sz")     // 14 15 (front, r=Rc)
    (0 #calc "$Rc*$cy" #calc "-$Rc*$sz") (0 #calc "$Rc*$cy" #calc "$Rc*$sz")                        // 16 17 (r=Rc at wafer plane)
);
blocks
(
    hex (0 1 3 2 0 1 5 4)      (30 150 1) simpleGrading (1 1 1)     // A wafer region
    hex (2 3 7 6 4 5 9 8)      (30 25 1)  simpleGrading (1 1 1)     // B above the edge ring
    hex (6 7 13 16 8 9 15 17)  (30 25 1)  simpleGrading (1 1 1)     // C upper pump annulus (above wafer plane)
    hex (10 6 16 12 11 8 17 14) (25 25 1) simpleGrading (1 1 1)     // D lower pump annulus (below wafer plane)
);
edges ();
boundary
(
    showerhead { type patch; faces ((1 3 5 1)); }
    topWall    { type wall;  faces ((3 7 9 5) (7 13 15 9)); }
    wafer      { type wall;  faces ((0 2 4 0)); }
    edgeRing   { type wall;  faces ((2 6 8 4)); }
    ringOuter  { type wall;  faces ((10 6 8 11)); }        // vertical face of the ring below the wafer plane (r = Rr)
    outlet     { type patch; faces ((10 12 14 11)); }       // floor of the pump annulus
    outerWall  { type wall;  faces ((12 16 17 14) (16 13 15 17)); }
    axis       { type empty; faces ((0 1 1 0)); }
    front      { type wedge; faces ((0 1 3 2) (2 3 7 6) (6 7 13 16) (10 6 16 12)); }
    back       { type wedge; faces ((0 4 5 1) (4 8 9 5) (8 17 15 9) (11 14 17 8)); }
);
mergePatchPairs ();
