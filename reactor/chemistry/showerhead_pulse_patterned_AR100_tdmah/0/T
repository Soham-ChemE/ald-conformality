FoamFile { version 2.0; format ascii; class volScalarField; object T; }
// T is the TDMAH mole fraction normalised to its showerhead value during the pulse (dimensionless carrier).
dimensions [0 0 0 1 0 0 0];
internalField   uniform 0;
boundaryField
{
    // 0.1 s pulse at unit concentration, then purge
    // Danckwerts total-flux inlet: U (c_face - c0(t)) = D (c_face - c_cell)/delta, so the TMA entering the chamber is
    // exactly U*c0*A during the pulse. As a mixed BC: value fraction f = U/(U + D/delta) = 0.0501/(0.0501 + 14.5) = 0.003445.
    showerhead
    {
        type                 uniformMixed;
        uniformValue         table ((0 1) (20.0 1) (20.0001 0) (100 0));
        uniformGradient      constant 0;
        uniformValueFraction constant 0.00344537;
    }
    topWall    { type zeroGradient; }
    // self-limiting ALD surface: s on open sites, coverage theta integrated per face (reactor/lib/aldWallKinetics)
    // TDMAH (M 354.7): vbar 185 m/s at 573 K; s 0.007 and N0 2.77e+18 Hf/m2 from the literature (see
    // reactor/chemistry/make_tdmah_case.py); c0 = precursor number density in the feed at T = 1, 3 Pa at 573 K -> 3.79e20 1/m3.
    wafer      { type patternedSurface; s 0.007; r 0; vbar 185; N0 2.77e+18; c0 3.79e20; d 100e-9; AR 100; holeDensity 1.78e13; nCells 200; value uniform 0; }
    floor      { type zeroGradient; }
    outlet     { type inletOutlet; inletValue uniform 0; value uniform 0; }
    axis       { type empty; }
    front      { type wedge; }
    back       { type wedge; }
}
