FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application     scalarTransportFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         4.1;        // 0.1 s pulse + 4 s purge
deltaT          0.001;
writeControl    runTime;
writeInterval   0.005;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
functions
{
    // TMA at the wafer-adjacent cell centres (nearCellValue). Wall flux = DT * T_cell / delta, delta = 0.25 mm
    // (half the uniform 0.5 mm axial cell), which is the finite-volume snGrad on this orthogonal mesh.
    waferFlux
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   raw;
        interpolationScheme cell;
        fields          (T);
        surfaces        ( wafer { type patch; patches (wafer); interpolate false; nearCellValue true; } );
    }
}
