# OpenFOAM outputs anywhere under reactor/ (any depth): time directories except 0/, solver logs, postProcessing, meshes,
# and the frozen-flow fields copied into derived cases (the steady cases' own 0/U are the inputs and stay tracked)
reactor/**/[0-9]*/
!reactor/**/0/
reactor/**/log.*
reactor/**/postProcessing/
reactor/**/polyMesh/
reactor/**/0/U
reactor/**/0/phi
!reactor/showerhead_steady/0/U
!reactor/edgering_steady/0/U

# library built by reproduce.sh (CI and Docker) into the workspace
.openfoam-user/

# derived 3D-case files: cell-centre fields written by postProcess, the pulse timing copy, and the wafer-field cache
reactor/**/0/C
reactor/**/0/Cx
reactor/**/0/Cy
reactor/**/0/Cz
reactor/chamber3d/pulse_timing/
reactor/**/*.npz

# kinetics library and voxel Monte Carlo solver builds (lib/aldkin, lib/aldmc; reproduce.sh --build or cmake)
lib/aldkin/build/
lib/aldkin/log.cmake
lib/aldmc/build/
lib/aldmc/log.cmake
